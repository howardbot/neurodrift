# Copy to .env and edit. Never commit .env.
ENVIRONMENT=production
LOG_LEVEL=INFO

POSTGRES_USER=neurodrift
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=neurodrift

# JSON list of allowed browser origins. Same-origin requests through nginx need none.
CORS_ORIGINS=[]

MAX_UPLOAD_MB=500
MAX_SESSIONS_PER_PROJECT=30

# Where nginx listens on the host. Use HTTP_BIND=127.0.0.1 and another HTTP_PORT when a
# host-level reverse proxy (with TLS) already owns ports 80/443.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
